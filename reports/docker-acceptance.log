name: ai-security-intelligence-workbench
services:
  workbench:
    build:
      context: D:\新建文件夹\2026-09-26\ba\ai-security-intelligence-workbench
      dockerfile: Dockerfile
    container_name: ai-security-intelligence-workbench
    environment:
      DEEPSEEK_API_KEY: ""
      GITHUB_TOKEN: ""
      INTEL_ALERT_WEBHOOK_URL: ""
      INTEL_JSON_LOGS: "1"
      INTEL_MODEL_BASE_URL: https://api.deepseek.com/v1
      INTEL_MODEL_NAME: deepseek-chat
      INTEL_USE_MODEL: "1"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health',
          timeout=3).read()
      timeout: 5s
      interval: 30s
      retries: 3
      start_period: 15s
    image: ai-security-intelligence-workbench:0.2.2
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 8000
        published: "18000"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: D:\新建文件夹\2026-09-26\ba\ai-security-intelligence-workbench\data
        target: /app/data
        bind: {}
      - type: bind
        source: D:\新建文件夹\2026-09-26\ba\ai-security-intelligence-workbench\artifacts
        target: /app/artifacts
        bind: {}
      - type: bind
        source: D:\新建文件夹\2026-09-26\ba\ai-security-intelligence-workbench\reports
        target: /app/reports
        bind: {}
networks:
  default:
    name: ai-security-intelligence-workbench_default
