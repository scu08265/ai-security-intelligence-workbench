# Copy to .env and fill in. .env is gitignored; never commit real keys.

# OpenAI-compatible endpoint used by the optional model planner.
# Leave unset to run in local evidence-extraction mode.
DEEPSEEK_API_KEY=
INTEL_USE_MODEL=1
INTEL_MODEL_BASE_URL=https://api.deepseek.com/v1
INTEL_MODEL_NAME=deepseek-chat

# Optional. Raises the GitHub Advisory API rate limit from 60/h to 5000/h.
# Without it that collector reports an honest 403 instead of collecting.
GITHUB_TOKEN=

# Override the data directory (defaults to ./data).
# INTEL_DATA_DIR=
