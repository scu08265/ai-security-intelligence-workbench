# Copy to .env and fill in. .env is gitignored; never commit real keys.

APP_VERSION=0.2.2

# OpenAI-compatible endpoint used by the optional model planner.
# Leave unset to run in local evidence-extraction mode.
DEEPSEEK_API_KEY=
INTEL_USE_MODEL=1
INTEL_MODEL_BASE_URL=https://api.deepseek.com/v1
INTEL_MODEL_NAME=deepseek-chat

# Optional. Raises the GitHub Advisory API rate limit from 60/h to 5000/h.
# Without it that collector reports an honest 403 instead of collecting.
GITHUB_TOKEN=

# Optional JSONL/webhook failure alerts.
INTEL_ALERT_WEBHOOK_URL=
INTEL_JSON_LOGS=0

# Optional NVD key raises the API rate limit. Without it the collector still
# drains all pages and waits NVD_PAGE_DELAY_SECONDS between page requests.
NVD_API_KEY=
NVD_MAX_PAGES=100
NVD_PAGE_DELAY_SECONDS=6

# Override the data directory (defaults to ./data).
# INTEL_DATA_DIR=
